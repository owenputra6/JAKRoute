# Start with the demo: no OpenAI/Ollama/network call needed for indoor testing.
APP_ENV=development
AGENT_MODE=demo
MAPID_MODE=demo
WEATHER_MODE=demo
FORUM_MODE=demo
AUTH_MODE=demo
STATION_DATA_MODE=demo

# Route AI: AGENT_MODE=openai; forum AI: FORUM_MODE=openai.
# Both use this same OpenAI key/model and structured output.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Independent forum processor: FORUM_MODE=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
# Forum extraction is structured classification; thinking stays disabled in code.

# MAPID_MODE=live requires the verified data/mapid_contract.json request/response mapping.
MAPID_API_KEY=

# WEATHER_MODE=google. Hujan = warning only, never a routing weight.
GOOGLE_WEATHER_API_KEY=

# Officer credential: server/manual officer client only. Never ship in Flutter.
OFFICER_TOKEN=

# AUTH_MODE=token is for private development. AUTH_MODE=supabase validates user sessions.
API_TOKEN=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_STATION_TABLE=station_locations

# Exactly 100 weighted dummy people sampled from palmerah_crowd_areas.geojson.
CROWD_USER_COUNT=100
CROWD_SEED=20260908
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# DATA_DIR and DB_PATH may be absolute paths; defaults are backend/data and backend/runtime/forum.sqlite3.
